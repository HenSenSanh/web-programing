<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Legacy URL redirects after moving frontend into app/public/frontend/
    RewriteRule ^tv4_data_pipeline\.html$ /frontend/live-ops/ [R=302,L]
    RewriteRule ^frontend/tv4_data_pipeline\.html$ /frontend/live-ops/ [R=302,L]
    RewriteRule ^frontend/tv1/(.*)$ /frontend/admin/$1 [R=302,L]
    RewriteRule ^frontend/kds\.html$ /frontend/kds/ [R=302,L]
    RewriteRule ^frontend/pos\.html$ /frontend/pos/ [R=302,L]

    # Route all API requests to api_router.php
    RewriteRule ^api/v1/(.*)$ api_router.php [QSA,L]
    RewriteRule ^api/v1$ api_router.php [QSA,L]
</IfModule>
