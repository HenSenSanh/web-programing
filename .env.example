APP_NAME=DineFlow QRDine
APP_ENV=local
APP_URL=http://localhost:8080
# Tuy chon dat URL cong khai (Render / Cloudflare Tunnel / ngrok / IP Wi-Fi) cho ma QR:
# QR_BASE_URL=https://your-app.onrender.com

DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=dineflow_db
DB_USERNAME=dineflow
DB_PASSWORD=dineflow123
DB_ROOT_PASSWORD=root123

# Cau hinh VietQR dong cho POS & hoa don in (Napas 247 via img.vietqr.io)
VIETQR_BANK_ID=MB
VIETQR_ACCOUNT_NO=0905000000
VIETQR_ACCOUNT_NAME=DINEFLOW RESTAURANT
VIETQR_TEMPLATE=compact2

# Tuy chon upload anh mon an len Cloudinary (giai quyet mat anh khi deploy Render Free)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset
# CLOUDINARY_FOLDER=dineflow/menu

# Gioi han tan suat goi API khach (1 = bat, 0 = tat)
RATE_LIMIT_ENABLED=1

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=DineFlow QRDine

SESSION_NAME=DINEFLOW_SESSION
